{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile for AssetSilo",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the user",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "description": "Account role",
          "enum": ["freelancer", "client"],
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when user profile was created",
          "maxLength": 64
        }
      },
      "required": ["userId", "email", "role", "createdAt"]
    },
    "AimConfig": {
      "title": "AimConfig",
      "description": "Saved PC or Mobile FPS aim, sensitivity, HUD, and crosshair loadout",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Loadout name",
          "maxLength": 100
        },
        "platform": {
          "type": "string",
          "description": "Target platform category",
          "enum": ["PC", "Mobile"],
          "maxLength": 16
        },
        "game": {
          "type": "string",
          "description": "Target FPS game",
          "enum": ["Valorant", "CS2", "Apex Legends", "Overwatch 2", "CODM", "PUBGM", "ROS", "BloodStrike"],
          "maxLength": 40
        },
        "tags": {
          "type": "string",
          "description": "Comma-separated tags for searching presets",
          "maxLength": 160
        },
        "dpi": {
          "type": "number",
          "description": "PC mouse DPI setting"
        },
        "sensitivity": {
          "type": "number",
          "description": "PC in-game sensitivity"
        },
        "edpi": {
          "type": "number",
          "description": "PC effective DPI (DPI * sensitivity)"
        },
        "cm360": {
          "type": "number",
          "description": "PC physical centimeters per 360-degree turn"
        },
        "crosshairCode": {
          "type": "string",
          "description": "PC semicolon-delimited Valorant crosshair code",
          "maxLength": 255
        },
        "resolution": {
          "type": "string",
          "description": "PC display resolution or aspect ratio",
          "maxLength": 40
        },
        "cameraSens": {
          "type": "number",
          "description": "Mobile camera sensitivity percentage"
        },
        "adsSens": {
          "type": "number",
          "description": "Mobile ADS / Scope sensitivity percentage"
        },
        "gyroSens": {
          "type": "number",
          "description": "Mobile gyroscope sensitivity percentage"
        },
        "fingerSetup": {
          "type": "string",
          "description": "Mobile finger claw layout",
          "enum": ["2-Thumb", "3-Finger Claw", "4-Finger Claw", "5-Finger Claw", "6-Finger Claw"],
          "maxLength": 40
        },
        "hudCode": {
          "type": "string",
          "description": "Mobile HUD layout share code",
          "maxLength": 255
        },
        "notes": {
          "type": "string",
          "description": "Optional setup notes",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update",
          "maxLength": 64
        }
      },
      "required": [
        "userId",
        "name",
        "game",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles restricted to the authenticated user"
    },
    "/users/{userId}/configs/{configId}": {
      "schema": "AimConfig",
      "description": "Saved PC and Mobile aim and crosshair loadouts scoped strictly to the owning user"
    }
  }
}
