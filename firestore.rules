rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly(['userId', 'email', 'role', 'createdAt', 'displayName'])
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.email is string && data.email.size() <= 256
        && (data.role == 'freelancer' || data.role == 'client')
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120));
    }

    // Validation for AssetFile (Metadata only, without Firebase Storage blobs)
    function isValidAssetFile(data) {
      return data.keys().hasAll(['userId', 'name', 'size', 'type', 'uploadedAt'])
        && data.keys().hasOnly(['userId', 'name', 'size', 'type', 'uploadedAt', 'clientName', 'notes'])
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 255
        && data.size is number && data.size >= 0
        && data.type is string && data.type.size() <= 120
        && data.uploadedAt is string && data.uploadedAt.size() <= 64
        && (!('clientName' in data) || (data.clientName is string && data.clientName.size() <= 120))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    // Test connection document for connection healthcheck
    match /test/connection {
      allow read: if true;
    }

    // User Profile Documents
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserProfile(incoming());
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role']);
      allow delete: if false;
    }

    // Asset Files Collection (Metadata stored in Firestore)
    match /files/{fileId} {
      allow get: if isSignedIn() && isValidId(fileId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(fileId) && isValidAssetFile(incoming());
      allow update: if isSignedIn() && isValidId(fileId)
        && isValidAssetFile(incoming())
        && incoming().userId == existing().userId
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'clientName', 'notes']);
      allow delete: if isSignedIn() && isValidId(fileId) && resource.data.userId == request.auth.uid;
    }
  }
}
